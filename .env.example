NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/senda

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

BASE_RPC_URL=https://mainnet.base.org
CHECKOUT_RECONCILIATION_INTERVAL_MS=15000

# Trust the first N proxies when resolving client IPs. Set this to the number
# of verified reverse proxies in front of the Railway deployment.
TRUST_PROXY_HOPS=1

# Request budgets. All windows are in milliseconds.
RATE_LIMIT_IP_AUTH_MAX=5
RATE_LIMIT_IP_AUTH_WINDOW_MS=900000
RATE_LIMIT_IP_PUBLIC_MAX=60
RATE_LIMIT_IP_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_IP_RPC_MAX=10
RATE_LIMIT_IP_RPC_WINDOW_MS=60000
RATE_LIMIT_MERCHANT_MAX=20
RATE_LIMIT_MERCHANT_WINDOW_MS=60000

# Maximum age, in seconds, that a merchant session is considered fresh enough
# for sensitive operations such as changing the receiving wallet.
MERCHANT_SESSION_FRESH_AGE_SECONDS=300

# Delay before a requested receiving-wallet replacement becomes active, in
# seconds. The current address stays active during the window so payment links
# created in that time continue to use it.
MERCHANT_WALLET_CHANGE_DELAY_SECONDS=86400

# Durable operator alerts. Delivery is intentionally disabled until a
# server-controlled receiver and bearer token are configured. Production must
# use webhook mode; never accept either value from merchant or public input.
OPERATIONAL_ALERTS_MODE=disabled
OPERATIONAL_ALERT_WEBHOOK_URL=
OPERATIONAL_ALERT_WEBHOOK_TOKEN=
OPERATIONAL_ALERT_DISPATCH_INTERVAL_MS=15000
OPERATIONAL_ALERT_BATCH_SIZE=20
OPERATIONAL_ALERT_LEASE_MS=60000
OPERATIONAL_ALERT_TIMEOUT_MS=5000
OPERATIONAL_ALERT_MAX_ATTEMPTS=8
OPERATIONAL_ALERT_RETRY_BASE_MS=30000
OPERATIONAL_ALERT_RETRY_MAX_MS=900000
