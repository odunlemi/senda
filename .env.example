NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/senda

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

BASE_RPC_URL=https://mainnet.base.org
CHECKOUT_RECONCILIATION_INTERVAL_MS=15000

# Trust the first N proxies when resolving client IPs. Set this to the number
# of verified reverse proxies in front of the Railway deployment.
TRUST_PROXY_HOPS=1

# Request budgets. All windows are in milliseconds.
RATE_LIMIT_IP_AUTH_MAX=5
RATE_LIMIT_IP_AUTH_WINDOW_MS=900000
RATE_LIMIT_IP_PUBLIC_MAX=60
RATE_LIMIT_IP_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_IP_RPC_MAX=10
RATE_LIMIT_IP_RPC_WINDOW_MS=60000
RATE_LIMIT_MERCHANT_MAX=20
RATE_LIMIT_MERCHANT_WINDOW_MS=60000
